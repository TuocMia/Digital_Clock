STD_LIB = ../STM32F10x_StdPeriph_Lib_V3.5.0/Libraries
STD_DEV = $(STD_LIB)/CMSIS/CM3/DeviceSupport/ST/STM32F10x
STD_DRV = $(STD_LIB)/STM32F10x_StdPeriph_Driver
RTOS    = middlewares/FreeRTOS

CC      = arm-none-eabi-gcc
OBJCOPY = arm-none-eabi-objcopy

CFLAGS  = -mcpu=cortex-m3 -mthumb -Os -g -Wall
CFLAGS += -ffunction-sections -fdata-sections
CFLAGS += -DSTM32F10X_MD -DUSE_STDPERIPH_DRIVER
CFLAGS += -I. -Ibsp -Ihal/inc -Iapp/inc
CFLAGS += -I$(RTOS) -I$(RTOS)/include
CFLAGS += -I$(RTOS)/portable/GCC/ARM_CM3
CFLAGS += -I$(STD_LIB)/CMSIS/CM3/CoreSupport
CFLAGS += -I$(STD_DEV) -I$(STD_DRV)/inc

SRCS  = alarm_test_main.c
SRCS += bsp/stm32f10x_it.c bsp/system_stm32f10x.c
SRCS += hal/src/hal_gpio.c
SRCS += app/src/app_ipc.c app/src/task_alarm.c app/src/app_hooks.c
SRCS += $(RTOS)/tasks.c $(RTOS)/queue.c $(RTOS)/list.c
SRCS += $(RTOS)/event_groups.c
SRCS += $(RTOS)/portable/GCC/ARM_CM3/port.c
SRCS += $(RTOS)/portable/MemMang/heap_4.c
SRCS += $(STD_DRV)/src/stm32f10x_rcc.c
SRCS += $(STD_DRV)/src/stm32f10x_gpio.c

ASM     = $(STD_DEV)/startup/gcc_ride7/startup_stm32f10x_md.s
LDFLAGS = -Tbsp/linker.ld -nostartfiles --specs=nosys.specs
LDFLAGS += -Wl,--gc-sections

all: firmware-alarm.bin

firmware-alarm.elf: $(SRCS) $(ASM) bsp/linker.ld
	$(CC) $(CFLAGS) $(LDFLAGS) $(ASM) $(SRCS) -o $@

firmware-alarm.bin: firmware-alarm.elf
	$(OBJCOPY) -O binary $< $@

flash: firmware-alarm.bin
	openocd -f interface/stlink.cfg -f target/stm32f1x.cfg \
		-c "program firmware-alarm.bin verify reset exit 0x08000000"

clean:
	rm -f firmware-alarm.elf firmware-alarm.bin

.PHONY: all flash clean