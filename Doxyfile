# Doxyfile for Digital_Clock (STM32F103C8T6 + FreeRTOS)

PROJECT_NAME           = "Digital Clock (STM32 + FreeRTOS)"
PROJECT_NUMBER         = "v1.0.0"
PROJECT_BRIEF          = "STM32F103C8T6 FreeRTOS Digital Clock with DS1302 RTC, ST7789 240x240 LCD, and Vietnamese Lunar Calendar"

OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
FULL_PATH_NAMES        = NO
SORT_BRIEF_DOCS        = YES

INPUT                  = README.md main.c bsp hal app
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */middlewares/* */tests/* */stm32f10x_* */system_stm32f10x.c */FreeRTOSConfig.h
USE_MDFILE_AS_MAINPAGE = README.md

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_TREEVIEW      = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
